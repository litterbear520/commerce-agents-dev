# Copy to .env at the repo root and add your key. The example APIs (examples/demo_common/host.py)
# read this file, after the environment and the example's own .env; the SDK consoles and the
# MCP servers read the environment only. Never put a real key in this file.
ANTHROPIC_API_KEY=
# Optional: the API endpoint, for a gateway or proxy that speaks the Messages API.
# Leave blank for the default, https://api.anthropic.com.
ANTHROPIC_BASE_URL=
# Optional: the model both roles' turn loops run on in the example APIs. Leave blank for
# each role's own default (see docs/deployment.md, "Model ids").
ANTHROPIC_MODEL=
